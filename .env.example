# Kyul Group Portal — environment variables
# Copy this file to `.env` for local dev (`.env` is gitignored). For production,
# set the same keys in your host: Cloudflare Pages → Settings → Environment variables.

# Session signing secret — use a long random string in production (mark Encrypt).
# Generate (PowerShell): [Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
NUXT_SESSION_SECRET=

# First-run seed passwords for the two built-in accounts.
# Used ONLY when the user store is first created. If left blank, a strong random
# password is generated and printed to the server log once. Change after first sign-in.
# Quote values containing special characters — an unquoted '#' starts a comment.
NUXT_SEED_ADMIN_PASSWORD="change-me-admin"
NUXT_SEED_SUPERADMIN_PASSWORD="change-me-superadmin"

# Public site URL (canonical / Open Graph / sitemap).
NUXT_PUBLIC_SITE_URL=https://www.kyulgroup.com
